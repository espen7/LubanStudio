+// but exceljs xforms dispatch on unprefixed element names for the main parts.
+// Normalise element names to their local part, except for prefixes whose qualified
+// names are matched verbatim by xforms (docProps: dc/cp/dcterms/dcmitype/xsi/vt;
+// drawings: xdr/a). Attribute keys are left untouched ('r:id' etc.).
+const KEEP_PREFIX = new Set(['dc', 'cp', 'dcterms', 'dcmitype', 'xsi', 'vt', 'xdr', 'a']);
